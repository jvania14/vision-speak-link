# Set these in the hosting environment. Do not put API keys in source.

# Comma-separated list of allowed frontend origins for CORS. "*" allows any
# origin (fine for local dev, not for production).
FRONTEND_ORIGIN=http://127.0.0.1:8080

# Optional: used to insert spaces into fingerspelled sequences. Recognition
# still works without this, just without word-spacing cleanup.
OPENAI_API_KEY=

# Max accepted request body size in bytes (default 3MB).
MAX_FRAME_BYTES=3145728

# Minimum model confidence (0-1) for a predicted letter to be treated as valid.
RECOGNITION_CONFIDENCE_THRESHOLD=0.30

# Number of consecutive matching frames required before a letter is committed
# to the text buffer.
RECOGNITION_STABLE_FRAMES=3

# Minimum seconds between committing the same letter twice in a row.
RECOGNITION_LETTER_COOLDOWN_SECONDS=0.8

# Set to 1 to log per-frame detection/prediction debug output to the server console.
DEBUG_RECOGNITION=0
